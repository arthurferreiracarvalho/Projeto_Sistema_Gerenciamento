<Window x:Class="Sistema_Gerenciamento_Usuários.VisualizarUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciamento de Usuários" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Usuários Cadastrados no Banco de Dados" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Margin="0,0,0,15" 
                   Grid.Row="0" 
                   FontFamily="Rockwell Extra Bold"/>

        <Border Grid.Row="1" Background="#F4F4F6" Padding="12" CornerRadius="8" Margin="0,0,0,15">
            <WrapPanel VerticalAlignment="Center">

                <StackPanel Orientation="Vertical" Margin="0,0,15,5">
                    <TextBlock Text="Pesquisar (Nome/Usuário, Email):" FontSize="11" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,3" FontFamily="Rockwell Extra Bold"/>
                    <TextBox x:Name="txtPesquisa" Width="230" Height="28" VerticalContentAlignment="Center" Padding="4,0" TextChanged="txtPesquisa_TextChanged"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,15,5">
                    <TextBlock Text="Perfil:" FontSize="11" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,3" FontFamily="Rockwell Extra Bold"/>
                    <ComboBox x:Name="cmbPerfil" Width="140" Height="28" SelectionChanged="cmbPerfil_SelectionChanged" FontFamily="Rockwell Extra Bold">
                        <ComboBoxItem Content="Todos os Perfis" IsSelected="True"/>
                        <ComboBoxItem Content="Administrador"/>
                        <ComboBoxItem Content="Usuário"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,15,5">
                    <TextBlock Text="Status:" FontSize="11" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,3" FontFamily="Rockwell Extra Bold"/>
                    <ComboBox x:Name="cmbStatus" Width="153" Height="28" SelectionChanged="cmbStatus_SelectionChanged" FontFamily="Rockwell Extra Bold">
                        <ComboBoxItem Content="Status do Usuário" IsSelected="True"/>
                        <ComboBoxItem Content="Ativo"/>
                        <ComboBoxItem Content="Inativo"/>
                    </ComboBox>
                </StackPanel>

            </WrapPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="ContainerCards" HorizontalAlignment="Center"/>
        </ScrollViewer>
    </Grid>
</Window>