<Window x:Class="Sistema_Gerenciamento_Usuários.AlterarSenhaUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sistema_Gerenciamento_Usuários"
        mc:Ignorable="d"
        Title="Alterar Minha Senha" Height="420" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F5F7">

    <Grid Margin="20">
        <Border Background="White" CornerRadius="12" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="Black"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ALTERAR SENHA" FontSize="20" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,20" FontFamily="Rockwell Extra Bold"/>

                <TextBlock Text="Senha Atual:" FontWeight="Bold" Foreground="#444" Margin="0,5,0,2" FontSize="18" FontFamily="Rockwell Extra Bold"/>
                <PasswordBox x:Name="pwdSenhaAtual" Height="30" FontSize="14" Padding="5,3" VerticalContentAlignment="Center" Background="#F9F9F9" BorderBrush="#CCC"/>

                <TextBlock Text="Nova Senha:" FontWeight="Bold" Foreground="#444" Margin="0,12,0,2" FontSize="18" FontFamily="Rockwell Extra Bold"/>
                <PasswordBox x:Name="pwdNovaSenha" Height="30" FontSize="14" Padding="5,3" VerticalContentAlignment="Center" Background="#F9F9F9" BorderBrush="#CCC"/>

                <TextBlock Text="Confirmar Nova Senha:" FontWeight="Bold" Foreground="#444" Margin="0,12,0,2" FontSize="18" FontFamily="Rockwell Extra Bold"/>
                <PasswordBox x:Name="pwdConfirmarSenha" Height="30" FontSize="14" Padding="5,3" VerticalContentAlignment="Center" Background="#F9F9F9" BorderBrush="#CCC"/>

                <Grid Margin="0,25,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnCancelar" Grid.Column="0" Content="CANCELAR" Click="btnCancelar_Click" Height="38" Background="#D32F2F" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" FontSize="20" FontFamily="Rockwell Extra Bold"/>
                    <Button x:Name="btnSalvar" Grid.Column="2" Content="ALTERAR" Click="btnSalvar_Click" Height="38" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" FontSize="20" FontFamily="Rockwell Extra Bold"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>