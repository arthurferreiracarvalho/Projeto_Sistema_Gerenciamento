<Window x:Class="Sistema_Gerenciamento_Usuários.CadastrarUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sistema_Gerenciamento_Usuários"
        mc:Ignorable="d"
        Title="CadastrarUsuario" Height="481" Width="800" Background="#FF545454">
    <Grid Margin="0,0,0,14">
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Imagens/Cadastro de Usuário.png"/>
        </Grid.Background>
        <Label x:Name="NomeUsuario" Content="Nome de Usuário" HorizontalAlignment="Center" Height="32" Margin="0,115,0,0" VerticalAlignment="Top" Width="376" Background="{x:Null}" FontSize="20" FontFamily="Rockwell Extra Bold"/>
        <TextBox x:Name="Nome_Usuario" HorizontalAlignment="Center" Height="30" TextWrapping="Wrap" VerticalAlignment="Top" Width="376" Background="#FFB7B7B7" Margin="0,141,0,0" FontSize="14" BorderBrush="Black"/>
        <Label x:Name="EmailUsuario" Content="Email do Usuário" HorizontalAlignment="Center" Height="30" Margin="0,175,0,0" VerticalAlignment="Top" Width="376" FontSize="20" FontFamily="Rockwell Extra Bold"/>
        <TextBox x:Name="Email_Usuario" HorizontalAlignment="Center" Height="30" TextWrapping="Wrap" VerticalAlignment="Top" Width="376" Background="#FFB7B7B7" FontSize="14" Margin="0,201,0,0" BorderBrush="Black"/>
        <TextBox x:Name="Nome_Completo" HorizontalAlignment="Center" Height="30" Margin="0,81,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="376" Background="#FFB7B7B7" FontSize="14" BorderBrush="Black" TextChanged="TextBox_TextChanged"/>
        <PasswordBox x:Name="Senha_Usuario" HorizontalAlignment="Center" Height="30" Margin="0,263,0,0" VerticalAlignment="Top" Width="376" Background="#FFB7B7B7" BorderBrush="Black"/>
        <PasswordBox x:Name="Confirmar_Senha" HorizontalAlignment="Center" Height="30" Margin="0,321,0,0" VerticalAlignment="Top" Width="376" Background="#FFB7B7B7" BorderBrush="Black"/>
        <Label x:Name="NomeCompleto" Content="Nome Completo" HorizontalAlignment="Left" Height="35" Margin="212,53,0,0" VerticalAlignment="Top" Width="204" FontSize="20" FontFamily="Rockwell Extra Bold"/>
        <Label x:Name="SenhaUsuario" Content="Senha do Usuário" HorizontalAlignment="Center" Height="33" Margin="0,237,0,0" VerticalAlignment="Top" Width="376" FontSize="20" FontFamily="Rockwell Extra Bold"/>
        <Label x:Name="ConfirmarSenha" Content="Confirmar Senha" HorizontalAlignment="Center" Height="40" Margin="0,295,0,0" VerticalAlignment="Top" Width="376" FontSize="20" FontFamily="Rockwell Extra Bold"/>
        <Button x:Name="Cadastrar" Content="CADASTRAR" HorizontalAlignment="Left" Height="40" Margin="135,367,0,0" VerticalAlignment="Top" Width="236" Foreground="White" Background="#FF228B00" BorderBrush="Black" FontSize="30" FontFamily="Rockwell Extra Bold" Click="Cadastrar_Click"/>
        <Button x:Name="Foto_Perfil" Content="FOTO DE PERFIL" Click="Foto_Perfil_Click" Margin="429,367,135,0" Background="#FF545454" Foreground="White" FontWeight="Bold" BorderBrush="Black" FontFamily="Rockwell Extra Bold" FontSize="22" Height="40" VerticalAlignment="Top"/>
        <Button x:Name="Voltar" Content="VOLTAR" HorizontalAlignment="Left" Height="31" Margin="84,21,0,0" VerticalAlignment="Top" Width="64" Background="White" BorderBrush="Black" FontFamily="Rockwell Extra Bold" Click="Voltar_Click"/>

    </Grid>
</Window>
