<Window x:Class="Sistema_Gerenciamento_Usuários.CadastrarUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sistema_Gerenciamento_Usuários"
        mc:Ignorable="d"
        Title="CadastrarUsuario" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Cadastro de Usuário.png"/>
        </Grid.Background>
        <Label Content="Nome de Usuário" HorizontalAlignment="Center" Height="32" Margin="0,115,0,0" VerticalAlignment="Top" Width="376" Background="{x:Null}" FontSize="20" FontFamily="Rockwell Extra Bold"/>
        <TextBox HorizontalAlignment="Center" Height="30" TextWrapping="Wrap" VerticalAlignment="Top" Width="376" Background="#FFB7B7B7" Margin="0,141,0,0" FontSize="14" BorderBrush="Black"/>
        <Label Content="Email do Usuário" HorizontalAlignment="Center" Height="30" Margin="0,176,0,0" VerticalAlignment="Top" Width="376" FontSize="20" FontFamily="Rockwell Extra Bold"/>
        <TextBox HorizontalAlignment="Center" Height="30" TextWrapping="Wrap" VerticalAlignment="Top" Width="376" Background="#FFB7B7B7" FontSize="14" Margin="0,201,0,0" BorderBrush="Black"/>
        <TextBox HorizontalAlignment="Center" Height="29" Margin="0,56,0,0" TextWrapping="Wrap" Text="Nome Completo" VerticalAlignment="Top" Width="376" FontSize="20" BorderBrush="{x:Null}" FontFamily="Rockwell Extra Bold" TextChanged="TextBox_TextChanged"/>
        <TextBox HorizontalAlignment="Center" Height="30" Margin="0,81,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="376" Background="#FFB7B7B7" FontSize="14" BorderBrush="Black"/>
        <TextBox HorizontalAlignment="Center" Height="28" Margin="0,237,0,0" TextWrapping="Wrap" Text="Senha (Obrigatória)" VerticalAlignment="Top" Width="376" FontSize="20" TextChanged="TextBox_TextChanged" FontFamily="Rockwell Extra Bold" BorderBrush="White"/>
        <PasswordBox HorizontalAlignment="Center" Height="30" Margin="0,263,0,0" VerticalAlignment="Top" Width="376" Background="#FFB7B7B7" BorderBrush="Black"/>
        <TextBox HorizontalAlignment="Center" Height="28" Margin="0,298,0,0" TextWrapping="Wrap" Text="Confirmar Senha" VerticalAlignment="Top" Width="376" FontSize="20" TextChanged="TextBox_TextChanged" FontFamily="Rockwell Extra Bold" BorderBrush="White"/>
        <PasswordBox HorizontalAlignment="Center" Height="30" Margin="0,321,0,0" VerticalAlignment="Top" Width="376" Background="#FFB7B7B7" BorderBrush="Black"/>
        <Button Content="CADASTRAR" HorizontalAlignment="Center" Height="42" Margin="0,366,0,0" VerticalAlignment="Top" Width="238" FontSize="25" BorderBrush="Black" Background="#FF058201" FontFamily="Rockwell Extra Bold" Foreground="White"/>

    </Grid>
</Window>
