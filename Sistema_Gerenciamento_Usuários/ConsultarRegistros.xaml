<Window x:Class="Sistema_Gerenciamento_Usuários.ConsultarRegistros"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sistema_Gerenciamento_Usuários"
        mc:Ignorable="d"
        Title="Consultar Registros de Auditoria" Height="500" Width="1005"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="REGISTROS DE AUDITORIA DO SISTEMA" 
                   FontSize="25" FontWeight="Bold" Foreground="Black" 
                   HorizontalAlignment="Center" Margin="0,0,0,15" FontFamily="Rockwell Extra Bold"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Buscar por Usuário ou Ação:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" FontFamily="Rockwell Extra Bold" FontSize="20"/>
            <TextBox x:Name="txtFiltro" Width="285" Height="28" VerticalContentAlignment="Center" KeyUp="txtFiltro_KeyUp"/>
            <Button x:Name="btnPesquisar" Content="Buscar" Width="140" Height="35" Margin="10,0,0,0" Click="btnPesquisar_Click" FontFamily="Rockwell Extra Bold" BorderBrush="Black" FontSize="20" Background="#FF256EFF" Foreground="White"/>
            <Button x:Name="btnAtualizar" Content="Atualizar" Width="140" Height="35" Margin="10,0,0,0" Click="btnAtualizar_Click" FontFamily="Rockwell Extra Bold" BorderBrush="Black" Background="#FF007F02" FontSize="20" Foreground="White"/>
        </StackPanel>

        <DataGrid x:Name="dgAuditoria" 
          Grid.Row="2" 
          AutoGenerateColumns="False" 
          IsReadOnly="True" 
          CanUserAddRows="False"
          Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data / Hora" 
                            Binding="{Binding DataHora, StringFormat=\{0:dd/MM/yyyy HH:mm:ss\}}" 
                            Width="130" />

                <DataGridTextColumn Header="Realizado Por" 
                            Binding="{Binding NomeUsuario}" 
                            Width="140" />

                <DataGridTextColumn Header="Ação" 
                            Binding="{Binding Acao}" 
                            Width="160" />

                <DataGridTextColumn Header="Descrição dos Detalhes" 
                            Binding="{Binding Descricao}" 
                            Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="lblTotalRegistros" Text="Total de Registros: 0" FontWeight="Bold" Foreground="Black" FontFamily="Rockwell Extra Bold" FontSize="20"/>
        </StackPanel>
    </Grid>
</Window>