<Window x:Class="Sistema_Gerenciamento_Usuários.ConsultarRegistros"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sistema_Gerenciamento_Usuários"
        mc:Ignorable="d"
        Title="Consultar Registros de Auditoria" Height="500" Width="850"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="REGISTROS DE AUDITORIA DO SISTEMA" 
                   FontSize="20" FontWeight="Bold" Foreground="#333333" 
                   HorizontalAlignment="Center" Margin="0,0,0,15" FontFamily="Rockwell Extra Bold"/>

        <!-- Filtro / Pesquisa -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Buscar por Usuário ou Ação:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <TextBox x:Name="txtFiltro" Width="250" Height="28" VerticalContentAlignment="Center" KeyUp="txtFiltro_KeyUp"/>
            <Button x:Name="btnPesquisar" Content="Buscar" Width="80" Height="28" Margin="10,0,0,0" Click="btnPesquisar_Click"/>
            <Button x:Name="btnAtualizar" Content="Atualizar" Width="80" Height="28" Margin="10,0,0,0" Click="btnAtualizar_Click"/>
        </StackPanel>

        <!-- Tabela -->
        <DataGrid x:Name="dgAuditoria" Grid.Row="2" AutoGenerateColumns="False" 
                  IsReadOnly="True" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                  Background="White" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data / Hora" Binding="{Binding DataHora, StringFormat=\{0:dd/MM/yyyy HH:mm:ss\}}" Width="140"/>
                <DataGridTextColumn Header="Realizado Por" Binding="{Binding NomeUsuario}" Width="130"/>
                <DataGridTextColumn Header="Ação" Binding="{Binding Acao}" Width="140"/>
                <DataGridTextColumn Header="Descrição dos Detalhes" Binding="{Binding Descricao}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Rodapé -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="lblTotalRegistros" Text="Total de Registros: 0" FontWeight="Bold" Foreground="#555555"/>
        </StackPanel>
    </Grid>
</Window>