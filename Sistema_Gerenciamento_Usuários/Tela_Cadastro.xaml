<Window x:Class="Sistema_Gerenciamento_Usuários.Tela_Cadastro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sistema_Gerenciamento_Usuários"
        mc:Ignorable="d"
        Title="Tela_Cadastro" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="0,0,0,-6">
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Imagens/Tela Entrar.png"/>
        </Grid.Background>
        <TextBox HorizontalAlignment="Center" Height="42" Margin="0,44,0,0" TextWrapping="Wrap" Text="LOGAR-SE" VerticalAlignment="Top" Width="212" FontSize="30" FontFamily="Rockwell Extra Bold" BorderBrush="White"/>
        <Label x:Name="EMAIL" Content="@EMAIL:" HorizontalAlignment="Left" Height="31" Margin="222,84,0,0" VerticalAlignment="Top" Width="86" RenderTransformOrigin="0.269,0.453" FontSize="15" FontFamily="Rockwell Extra Bold" Foreground="Black" Background="{x:Null}">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.193"/>
                    <RotateTransform Angle="0.014"/>
                    <TranslateTransform X="0.005" Y="-0.009"/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <Label x:Name="USUARIO" Content="USUÁRIO:" HorizontalAlignment="Left" Height="32" Margin="222,142,0,0" VerticalAlignment="Top" Width="91" RenderTransformOrigin="0.5,0.5" FontSize="15" FontFamily="Rockwell Extra Bold" Foreground="Black">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.193"/>
                    <RotateTransform Angle="0.014"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <Label x:Name="SENHA" Content="SENHA:" HorizontalAlignment="Left" Height="31" Margin="223,203,0,0" VerticalAlignment="Top" Width="98" RenderTransformOrigin="0.5,0.5" FontSize="15" FontFamily="Rockwell Extra Bold" Foreground="Black">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.189"/>
                    <RotateTransform Angle="0.014"/>
                    <TranslateTransform X="0.001"/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <PasswordBox x:Name="Senha" HorizontalAlignment="Center" Margin="0,226,0,0" VerticalAlignment="Top" Width="352" Height="29" FontSize="15" Background="#FFD4D4D4" OpacityMask="Black" BorderBrush="Black"/>
        <TextBox x:Name="Usuario" HorizontalAlignment="Center" VerticalAlignment="Top" Width="352" Height="29" FontSize="15" BorderBrush="Black" Background="#FFD4D4D4" Margin="0,167,0,0" />
        <TextBox x:Name="Email" HorizontalAlignment="Center" Margin="0,108,0,0" VerticalAlignment="Top" Width="352" Height="29" FontSize="15" BorderBrush="Black" Background="#FFD4D4D4"/>
        <PasswordBox x:Name="Comfirmar_senha" HorizontalAlignment="Center" Margin="0,286,0,0" VerticalAlignment="Top" Width="352" Height="29" FontSize="15" Background="#FFD4D4D4" BorderBrush="Black"/>
        <Label x:Name="COMFIRMAR_SENHA" Content="COMFIRMAR SENHA:" HorizontalAlignment="Left" Height="32" Margin="222,264,0,0" VerticalAlignment="Top" Width="246" RenderTransformOrigin="0.5,0.5" FontSize="15" FontFamily="Rockwell Extra Bold" Foreground="Black">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.193"/>
                    <RotateTransform Angle="0.014"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <Button x:Name="Confirmar" Content="CONFIRMAR" Height="45" Margin="294,336,294,0" VerticalAlignment="Top" Background="#FF545454" BorderBrush="Black" FontSize="25" FontFamily="Rockwell Extra Bold" Foreground="White" Click="Confirmar_Click"/>

    </Grid>
</Window>
