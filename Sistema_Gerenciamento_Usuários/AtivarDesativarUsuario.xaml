<Window x:Class="Sistema_Gerenciamento_Usuários.AtivarDesativarUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ativar / Desativar Usuário" Height="380" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">

            <TextBlock Text="⚙ ATIVAR / DESATIVAR" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="#2196F3" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,15" FontFamily="Rockwell Extra Bold"/>

            <Border Background="White" CornerRadius="8" BorderBrush="#CCCCCC" BorderThickness="1" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Nome de Usuário ou E-mail:" FontFamily="Rockwell Extra Bold" FontSize="15" Margin="0,0,0,8"/>
                    <TextBox x:Name="txtBuscar" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10" FontSize="13" KeyUp="txtBuscar_KeyUp"/>
                    <Button x:Name="btnBuscar" Content="🔍 BUSCAR USUÁRIO" Height="34" Background="#555555" Foreground="White" 
                            FontFamily="Rockwell Extra Bold" FontSize="15" Cursor="Hand" Click="btnBuscar_Click" BorderBrush="Black"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="5,0,0,15">
                <TextBlock x:Name="txtNomeCompleto" Text="Nome: -" FontWeight="Bold" FontSize="14" FontFamily="Rockwell Extra Bold" Margin="0,0,0,3"/>
                <TextBlock x:Name="txtNomeUsuario" Text="Usuário: -" Foreground="#FF8E8E8E" FontSize="13" FontFamily="Rockwell Extra Bold" Margin="0,0,0,3"/>
                <TextBlock x:Name="txtStatusAtual" Text="Status Atual: -" FontWeight="Bold" FontSize="14" Foreground="#333333" FontFamily="Rockwell Extra Bold"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnAlternarStatus" Content="🔄 ALTERAR STATUS" Width="240" Height="37" Background="Black" 
                        Foreground="White" FontWeight="Bold" FontSize="15" Margin="0,0,15,0" Cursor="Hand" 
                        Click="btnAlternarStatus_Click" BorderBrush="Black" FontFamily="Rockwell Extra Bold" IsEnabled="False"/>

                <Button x:Name="btnCancelar" Content="CANCELAR" Width="120" Height="37" Background="#555555" 
                        Foreground="White" FontWeight="Bold" FontSize="17" Cursor="Hand" 
                        Click="btnCancelar_Click" BorderBrush="Black" FontFamily="Rockwell Extra Bold"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>