<Window x:Class="Sistema_Gerenciamento_Usuários.EditarUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Usuário" Height="469" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F9F9F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Editar Informações do Usuário" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Grid.Row="0"
                   Margin="0,0,0,15" 
                   HorizontalAlignment="Center" 
                   FontFamily="Rockwell Extra Bold"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,5">
            <StackPanel Margin="10,0">

                <TextBlock Text="Imagem de Perfil (Avatar):" 
                           FontWeight="SemiBold" 
                           Margin="0,5,0,5" 
                           FontFamily="Rockwell Extra Bold" 
                           FontSize="15"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                    <Button x:Name="AnteriorFoto" Content="◀" Width="32" Height="32" Click="AnteriorFoto_Click" Margin="0,0,10,0" Cursor="Hand"/>
                    <Image x:Name="FotoPerfil" Width="70" Height="70" Stretch="Uniform"/>
                    <Button x:Name="ProximaFoto" Content="▶" Width="32" Height="32" Click="ProximaFoto_Click" Margin="10,0,0,0" Cursor="Hand"/>
                </StackPanel>

                <TextBlock x:Name="NomePerfil" HorizontalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,0,12"/>

                <TextBlock Text="Nome Completo:" FontWeight="SemiBold" Margin="0,5,0,3" FontFamily="Rockwell Extra Bold" FontSize="15"/>
                <TextBox x:Name="NomeCompleto" Height="30" VerticalContentAlignment="Center" Padding="5,0" BorderBrush="Black"/>

                <TextBlock Text="Nome de Usuário:" FontWeight="SemiBold" Margin="0,10,0,3" FontFamily="Rockwell Extra Bold" FontSize="15"/>
                <TextBox x:Name="NomeUsuario" Height="30" VerticalContentAlignment="Center" Padding="5,0" BorderBrush="Black"/>

                <TextBlock Text="E-mail:" FontWeight="SemiBold" Margin="0,10,0,3" FontFamily="Rockwell Extra Bold" FontSize="15"/>
                <TextBox x:Name="EmailUsuario" Height="30" VerticalContentAlignment="Center" Padding="5,0" BorderBrush="#FF080808"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,10,0">
            <Button x:Name="Cancelar" 
                    Content="Cancelar" 
                    Width="110" Height="34" 
                    Click="Cancelar_Click" 
                    Margin="0,0,10,0" 
                    FontFamily="Rockwell Extra Bold" 
                    FontSize="15" 
                    Cursor="Hand" BorderBrush="Black"/>

            <Button x:Name="Salvar" 
                    Content="Salvar Alterações" 
                    Width="167" Height="34" 
                    Background="#007ACC" 
                    Foreground="White" 
                    FontWeight="Bold" 
                    Click="Salvar_Click" 
                    FontFamily="Rockwell Extra Bold" 
                    FontSize="15" 
                    Cursor="Hand" BorderBrush="Black"/>
        </StackPanel>
    </Grid>
</Window>