<Window x:Class="Sistema_Gerenciamento_Usuários.EditarUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Usuário" Height="520" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Editar Informações do Usuário" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center" FontFamily="Rockwell Extra Bold"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="5,0">

                <TextBlock Text="Imagem de Perfil (Avatar):" FontWeight="SemiBold" Margin="0,5,0,3" FontFamily="Rockwell Extra Bold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Button x:Name="AnteriorFoto" Content="◀" Width="30" Height="30" Click="AnteriorFoto_Click" Margin="0,0,10,0"/>
                    <Image x:Name="FotoPerfil" Width="70" Height="70"/>
                    <Button x:Name="ProximaFoto" Content="▶" Width="30" Height="30" Click="ProximaFoto_Click" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="NomePerfil" HorizontalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,0,10"/>

                <TextBlock Text="Nome Completo:" FontWeight="SemiBold" Margin="0,5,0,2" FontFamily="Rockwell Extra Bold"/>
                <TextBox x:Name="NomeCompleto" Height="28" VerticalContentAlignment="Center" Padding="4,0"/>

                <TextBlock Text="Nome de Usuário:" FontWeight="SemiBold" Margin="0,8,0,2" FontFamily="Rockwell Extra Bold"/>
                <TextBox x:Name="NomeUsuario" Height="28" VerticalContentAlignment="Center" Padding="4,0"/>

                <TextBlock Text="E-mail:" FontWeight="SemiBold" Margin="0,8,0,2" FontFamily="Rockwell Extra Bold"/>
                <TextBox x:Name="EmailUsuario" Height="28" VerticalContentAlignment="Center" Padding="4,0"/>

                <TextBlock Text="Perfil de Acesso:" FontWeight="SemiBold" Margin="0,8,0,2" FontFamily="Rockwell Extra Bold"/>
                <ComboBox x:Name="PerfilUsuario" Height="28">
                    <ComboBoxItem Content="Usuário"/>
                    <ComboBoxItem Content="Administrador"/>
                </ComboBox>

                <TextBlock Text="Status do Usuário:" FontWeight="SemiBold" Margin="0,8,0,2" FontFamily="Rockwell Extra Bold"/>
                <ComboBox x:Name="StatusUsuario" Height="28">
                    <ComboBoxItem Content="Ativo (Liberado)"/>
                    <ComboBoxItem Content="Inativo (Bloqueado)"/>
                </ComboBox>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="Cancelar" Content="Cancelar" Width="92" Height="32" Click="Cancelar_Click" Margin="0,0,10,0" FontFamily="Rockwell Extra Bold" FontSize="13"/>
            <Button x:Name="Salvar" Content="Salvar Alterações" Width="144" Height="32" Background="#007ACC" Foreground="White" FontWeight="Bold" Click="Salvar_Click" FontFamily="Rockwell Extra Bold" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>