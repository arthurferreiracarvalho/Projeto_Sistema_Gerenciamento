<Window x:Class="Sistema_Gerenciamento_Usuários.AlterarNivelAcesso"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alterar Nível de Acesso" Height="480" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F4F5F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título Superior -->
        <TextBlock Text="ALTERAR NÍVEL DE ACESSO" 
                   FontSize="22" FontWeight="Bold" Foreground="#FFE67B00" 
                   HorizontalAlignment="Center" Margin="0,0,0,15" FontFamily="Rockwell Extra Bold"/>

        <!-- Card Principal (Container) -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#CCCCCC" Direction="270" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">

                <!-- Campo de Busca -->
                <TextBlock Text="Nome de Usuário ou E-mail:" FontWeight="Bold" Margin="0,0,0,5" FontSize="15" FontFamily="Rockwell Extra Bold"/>
                <TextBox x:Name="txtBuscar" Height="35" VerticalContentAlignment="Center" 
                         Padding="5" KeyUp="txtBuscar_KeyUp" Margin="0,0,0,10"/>

                <Button x:Name="btnBuscar" Content="🔍 BUSCAR USUÁRIO" Height="35" 
                        Background="#4A4A4A" Foreground="White" FontWeight="Bold" 
                        Cursor="Hand" Click="btnBuscar_Click" Margin="0,0,0,20" FontSize="18" FontFamily="Rockwell Extra Bold" BorderBrush="Black"/>

                <Separator Margin="0,0,0,15"/>

                <!-- Informações do Usuário Encontrado -->
                <TextBlock x:Name="txtNomeCompleto" Text="Nome: -" FontSize="14" FontWeight="Bold" Margin="0,0,0,5" FontFamily="Rockwell Extra Bold"/>
                <TextBlock x:Name="txtNomeUsuario" Text="Usuário: -" FontSize="13" Foreground="Gray" Margin="0,0,0,5" FontFamily="Rockwell Extra Bold"/>
                <TextBlock x:Name="txtEmail" Text="E-mail: -" FontSize="13" Foreground="Gray" Margin="0,0,0,5" FontFamily="Rockwell Extra Bold"/>
                <TextBlock x:Name="txtNivelAtual" Text="Nível Atual: -" FontSize="14" FontWeight="Bold" Foreground="#FFE67B00" Margin="0,0,0,20" FontFamily="Rockwell Extra Bold"/>

                <!-- Botões de Ação -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnAlternarNivel" Grid.Column="0" Content="ALTERAR PERMISSÃO" 
                            Height="40" Background="#FFE67B00" Foreground="White" 
                            Cursor="Hand" Click="btnAlternarNivel_Click" FontSize="16" FontFamily="Rockwell Extra Bold" BorderBrush="Black" Grid.ColumnSpan="3" Margin="0,0,123,0"/>

                    <Button x:Name="btnCancelar" Grid.Column="2" Content="CANCELAR" 
                            Height="40" Background="#FF4A4A4A" Foreground="White" FontWeight="Bold" 
                            Cursor="Hand" Click="btnCancelar_Click" FontSize="17" FontFamily="Rockwell Extra Bold" BorderBrush="Black" Margin="97,0,-5,0"/>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>