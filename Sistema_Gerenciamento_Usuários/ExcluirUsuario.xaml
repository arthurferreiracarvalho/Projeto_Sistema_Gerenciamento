<Window x:Class="Sistema_Gerenciamento_Usuários.ExcluirUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excluir Usuário" Height="360" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">

            <TextBlock Text="⚠ EXCLUIR USUÁRIO" 
                       FontSize="25" 
                       FontWeight="Bold" 
                       Foreground="#FFCC1C1C" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,15" FontFamily="Rockwell Extra Bold"/>

            <Border Background="White" 
                    CornerRadius="8" 
                    BorderBrush="#CCCCCC" 
                    BorderThickness="1" 
                    Padding="15" 
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Nome de Usuário ou E-mail:" FontFamily="Rockwell Extra Bold" FontSize="15" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtBuscar" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,10" FontFamily="Segoe UI" BorderBrush="Black"/>

                    <Button x:Name="btnBuscar" Content="🔍 BUSCAR USUÁRIO" Height="30" Background="#FF565656" Foreground="White" 
                            FontFamily="Rockwell Extra Bold" FontSize="18" Cursor="Hand" Click="btnBuscar_Click" BorderBrush="Black"/>
                </StackPanel>
            </Border>

            <!-- Exibição dos dados encontrados -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock x:Name="txtNomeCompleto" Text="Nome: -" FontWeight="Bold" FontSize="13" FontFamily="Rockwell Extra Bold" Margin="0,0,0,3"/>
                <TextBlock x:Name="txtNomeUsuario" Text="Usuário: -" Foreground="#FF8E8E8E" FontSize="12" FontFamily="Rockwell Extra Bold" Margin="0,0,0,3"/>
                <TextBlock x:Name="txtEmail" Text="E-mail: -" Foreground="#FF8E8E8E" FontSize="12" FontFamily="Rockwell Extra Bold"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnConfirmarExclusao" Content="🗑 EXCLUIR" Width="126" Height="37" Background="#D32F2F" 
                        Foreground="White" FontWeight="Bold" FontSize="17" Margin="0,0,15,0" Cursor="Hand" 
                        Click="btnConfirmarExclusao_Click" BorderBrush="Black" FontFamily="Rockwell Extra Bold"/>

                <Button x:Name="btnCancelar" Content="CANCELAR" Width="126" Height="37" Background="#FF565656" 
                        Foreground="White" FontWeight="Bold" FontSize="17" Cursor="Hand" 
                        Click="btnCancelar_Click" BorderBrush="Black" FontFamily="Rockwell Extra Bold"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>